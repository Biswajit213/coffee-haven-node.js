# ─────────────────────────────────────────────────────
# Coffee Haven — Docker Environment Variables
# Copy this file:  cp .env.example .env
# Then fill in your real credentials below.
# ⚠️  NEVER commit the .env file to version control!
# ─────────────────────────────────────────────────────

# ── General ──────────────────────────────────────────
NODE_ENV=production
PORT=5000

# ── MongoDB ──────────────────────────────────────────
# For the local Docker MongoDB container:
MONGO_URI=mongodb://mongo:27017/coffeehaven
# For MongoDB Atlas (uncomment and use instead):
# MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/coffeehaven?retryWrites=true&w=majority

# ── JWT Authentication ───────────────────────────────
JWT_SECRET=CHANGE_ME_to_a_long_random_string
JWT_EXPIRE=7d
JWT_COOKIE_EXPIRE=7

# ── Google OAuth 2.0 ────────────────────────────────
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# ── Cloudinary (Image Uploads) ──────────────────────
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ── Stripe (Payments) ───────────────────────────────
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key

# ── Email (Nodemailer SMTP) ─────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
FROM_NAME=Coffee Haven
FROM_EMAIL=noreply@coffeehaven.com

# ── Client URL (for CORS & redirects) ──────────────
CLIENT_URL=http://localhost:3000

# ── Frontend Build Arg ──────────────────────────────
VITE_API_URL=http://localhost:3000/api
